NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# https://account.mapbox.com/access-tokens — public token (pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR-MAPBOX-TOKEN

# ---- צד שרת בלבד (בלי NEXT_PUBLIC_) ----
# כתובת האתר לבניית pinUrl, בלי / בסוף
NEXT_PUBLIC_SITE_URL=https://your-storymap-domain.com
# Settings → API → service_role (סודי! לעולם לא בצד לקוח)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# סוד משותף עם MaxBi Social Planner: openssl rand -hex 32
EXTERNAL_PUBLISH_SECRET=CHANGE-ME
# id של הפרופיל שיהיה הבעלים של סיכות מה-Planner (Authentication → Users → User UID)
EXTERNAL_PUBLISH_USER_ID=00000000-0000-0000-0000-000000000000
# אופציונלי: דומיינים מותרים להורדת תמונות, מופרדים בפסיקים
EXTERNAL_IMAGE_HOSTS=

# Cloudflare R2 (R2 → Manage API tokens: Object Read & Write על ה-bucket)
R2_ACCOUNT_ID=YOUR-CLOUDFLARE-ACCOUNT-ID
R2_ACCESS_KEY_ID=YOUR-R2-ACCESS-KEY
R2_SECRET_ACCESS_KEY=YOUR-R2-SECRET
R2_BUCKET=storymap-photos
# Public access של ה-bucket: דומיין מותאם או https://pub-xxxx.r2.dev
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# AI: tag suggestions + translation to English (server only). Get a key at aistudio.google.com
# Without it, uploads still work: time-based tags only, text saved as typed.
GEMINI_API_KEY=YOUR-GEMINI-KEY
GEMINI_MODEL=gemini-3.8-flash
# Optional: photographer for Social Planner pins without photographerName (default "Max Bihovskiy")
EXTERNAL_DEFAULT_PHOTOGRAPHER=
